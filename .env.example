# Copy to .env on the server. Never commit the real .env file.
APP_ENV=production
TZ=America/Chicago

# OpenAI
OPENAI_API_KEY=replace_with_secret
OPENAI_AGENT_MODEL=gpt-5.6
OPENAI_ROUTER_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT=30
OPENAI_MAX_RETRIES=2
OPENAI_REASONING_EFFORT=medium
OPENAI_AGENT_MAX_OUTPUT_TOKENS=3000

# Public URLs and browser policy
PUBLIC_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
BACKEND_INTERNAL_URL=http://backend:8000
CORS_ALLOWED_ORIGINS=https://www.osakiusa.com,https://www.titanchair.com,https://www.osakimassagechair.com
TRUSTED_HOSTS=api.example.com,backend,localhost,127.0.0.1

# Keep the existing admin login if desired. Generate only the two machine
# secrets independently with: openssl rand -hex 32
ADMIN_USERNAME=replace_with_operator_name
ADMIN_PASSWORD=replace_with_existing_admin_password
ADMIN_SESSION_SECRET=replace_with_64_hex_characters
ADMIN_API_KEY=replace_with_a_different_64_hex_key

# Shopify webhook and stores
SHOPIFY_WEBHOOK_SECRET=replace_with_shopify_webhook_secret
# OsakiUSA catalog sync uses OSAKI_* credentials (read_products scope required).
TITAN_SHOP_DOMAIN=store.myshopify.com
TITAN_ACCESS_TOKEN=replace_with_secret
OSAKI_SHOP_DOMAIN=store.myshopify.com
OSAKI_ACCESS_TOKEN=replace_with_secret
OSAKIMASSAGE_SHOP_DOMAIN=store.myshopify.com
OSAKIMASSAGE_ACCESS_TOKEN=replace_with_secret
OSAKITITAN_SHOP_DOMAIN=store.myshopify.com
OSAKITITAN_ACCESS_TOKEN=replace_with_secret

# Delivery tracking (optional per store)
TRACK123_API_BASE_URL=https://api.track123.com
TRACK123_TRACKING_ENDPOINT_TEMPLATE=/tracking/query
TITAN_TRACK123_API_KEY=
TITAN_TRACK123_TOKEN=
OSAKI_TRACK123_API_KEY=
OSAKI_TRACK123_TOKEN=
OSAKIMASSAGE_TRACK123_API_KEY=
OSAKIMASSAGE_TRACK123_TOKEN=
OSAKITITAN_TRACK123_API_KEY=
OSAKITITAN_TRACK123_TOKEN=
AFTERSHIP_API_KEY=

# Email
EMAIL_SENDER=service@example.com
EMAIL_PASSWORD=replace_with_smtp_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
WARRANTY_TEAM_EMAIL=service@example.com
# Ops cron alerts (Shopify sync failures, RC health). Comma-separated; defaults to WARRANTY_TEAM_EMAIL.
OPS_ALERT_EMAIL=service@example.com

# Freshdesk
FRESHDESK_DOMAIN=company.freshdesk.com
FRESHDESK_API_KEY=replace_with_secret
WARRANTY_FRESHDESK_CREATE_CASE=1
# Require I Agree + email gate before web warranty chat mutators (1=on).
WARRANTY_REQUIRE_CHAT_PRIVACY=1
FRESHDESK_WARRANTY_GROUP_ID=
FRESHDESK_WARRANTY_PRODUCT_ID=
# Freshdesk status ID when warranty bot creates a ticket (2=Open; use field catalog script to look up custom IDs)
FRESHDESK_WARRANTY_STATUS_ID=2
# Required Freshdesk Type. Leave empty to auto-map (status Inquiry / damage+defect Issue with Product).
# Allowed: Issue with Product, Inquiry, Purchase Parts, Service Task, IDNT
FRESHDESK_WARRANTY_TYPE=
FRESHDESK_WARRANTY_DEFAULT_TYPE=Issue with Product

# RingCentral webhook authentication and credentials
RC_WEBHOOK_VERIFICATION_TOKEN=replace_with_64_hex_characters
RC_SERVER=https://platform.ringcentral.com
RC_CLIENT_ID=replace_with_secret
RC_CLIENT_SECRET=replace_with_secret
# RC_USER_JWT_FILE is an alternative for non-container deployments; ensure
# that path is mounted into the container before using it with Docker Compose.
RC_USER_JWT=replace_with_secret
RC_USER_JWT_FILE=
RC_WARRANTY_TRANSFER_EXTENSION=3
RC_WARRANTY_TRANSFER_TO=+18888482630
RC_SMS_FROM_NUMBER=+12145550123
RC_SMS_FOLLOWUP_ENABLED=true
RC_IVR_TEAM_EMAIL_ENABLED=true
RC_API_MAX_RETRIES=3
RC_EVENT_WORKER_ENABLED=true
RC_EVENT_RETENTION_DAYS=30
RC_CONNECT_TIMEOUT_SECONDS=5
RC_READ_TIMEOUT_SECONDS=25
RC_WEBHOOK_MAX_BODY_BYTES=262144
RC_TTS_MODEL=tts-1
RC_TTS_VOICE=nova
RC_TTS_TIMEOUT_SECONDS=20
# Optional pre-recorded HTTPS message used only if TTS is unavailable.
RC_FALLBACK_AUDIO_URI=
RC_WARRANTY_OPEN_TIME=10:00
RC_WARRANTY_CLOSE_TIME=18:00
RC_WARRANTY_OPEN_WEEKDAYS=0,1,2,3,4
# Comma-separated YYYY-MM-DD holidays/closures.
RC_WARRANTY_CLOSED_DATES=

# Abuse and cost controls
RATE_LIMIT_PER_MINUTE=30/minute
RATE_LIMIT_PER_HOUR=200/hour
WARRANTY_LLM_RATE_LIMIT=20/minute
# Warranty embed: refuse sales/off-topic free text (1 = on).
WARRANTY_SCOPE_GATE_ENABLED=1
WARRANTY_UPLOAD_RATE_LIMIT=10/hour
WARRANTY_OCR_RATE_LIMIT=5/hour
WARRANTY_STATUS_LOOKUP_RATE_LIMIT=20/hour
# Public Next.js origin for receipt-email status links (optional).
# WARRANTY_PUBLIC_APP_URL=https://app.example.com
CHAT_CACHE_ENABLED=1
CHAT_CACHE_TTL_SECONDS=600
CHAT_CACHE_MAX_ENTRIES=512

# ---------------------------------------------------------------------------
# Tidio Sales AI (OsakiUSA) — put secrets on the server only, never in git.
# Developer → Project data: Public / Private key
# Developer → OpenAPI: Generate OpenAPI key → Client Id + Client Secret
# Developer → Webhooks: stack secret (preferred over Project private key)
# ---------------------------------------------------------------------------
TIDIO_ENABLED=1
TIDIO_DOMAIN=osakiusa.com
TIDIO_PUBLIC_KEY=
TIDIO_PRIVATE_KEY=
TIDIO_WEBHOOK_SECRET=
TIDIO_OPENAPI_CLIENT_ID=
TIDIO_OPENAPI_CLIENT_SECRET=
# Operator UUID used when replying to Tidio tickets via OpenAPI.
TIDIO_OPERATOR_ID=
# Shared secret for Flow → POST /api/v1/sales/tidio/turn
# Put the same value in the Flow API Call header: X-Tidio-Turn-Secret
TIDIO_TURN_SECRET=
# Optional override (default https://api.tidio.co)
TIDIO_API_BASE=https://api.tidio.co
SALES_CHAT_RATE_LIMIT=60/minute

# Encrypted off-site backup target used by script/backup_db.sh.
# Example: s3://company-production-backups/osaki-ai-chat
BACKUP_S3_URI=
