# --- 빌드 컨텍스트 축소 (디스크·시간 절약) ---
# 호스트에서 만든 가상환경은 이미지에 넣지 않음 — Dockerfile에서 새로 pip install 함.
.venv/
venv/
env/

# Git / IDE
.git/
.gitignore
.idea/
.vscode/

# 캐시·파이썬 잡파일
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# 런타임에는 compose 볼륨으로 마운트됨 — 레이어에 복사 불필요(용량 폭발 방지)
faiss_index/
db_data/

# 인덱서 전용 대용량 데이터 — 컨테이너 앱은 FAISS 볼륨 + warranty JSON만 사용
data/*
!data/warranty_flowchart.json
!data/warranty_evidence_specs.json
!data/model_families.json
raw_data/

# 비밀·로컬 설정은 이미지에 포함 금지 (compose env_file로 주입)
.env
.env.*

# 문서·기타
*.md
.DS_Store
