# Next.js production frontend
# Build: docker build -f Dockerfile.frontend -t titan-frontend .
# Runs on port 3000
#
# Requires BuildKit for npm cache mount (default in Docker 23+):
#   DOCKER_BUILDKIT=1 docker compose build frontend

FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache ca-certificates

# Install dependencies — retries + cache for flaky EC2 ↔ npm registry links
FROM base AS deps
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm config set maxsockets 2
RUN --mount=type=cache,target=/root/.npm \
    sh -c 'set -e; \
    for attempt in 1 2 3 4 5; do \
      echo "npm ci attempt ${attempt}/5..."; \
      npm ci --no-audit --no-fund && exit 0; \
      echo "npm ci failed — waiting 45s before retry..."; \
      sleep 45; \
    done; \
    echo "npm ci failed after 5 attempts"; \
    exit 1'

# Build
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .
# Public client configuration is compiled into the bundle and must be explicit.
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN test -n "$NEXT_PUBLIC_API_BASE_URL" && npm run build

# Runtime
FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

USER node
EXPOSE 3000
ENV PORT=3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "server.js"]
