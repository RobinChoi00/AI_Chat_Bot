# 파이썬 3.11 슬림 버전(가벼운 Linux)을 기초 OS로 사용
FROM python:3.11-slim

# 작업 폴더 지정
WORKDIR /app

# 💡 [핵심] 리눅스 필수 빌드 도구(gcc, g++)를 설치하여 컴파일 에러 원천 차단
RUN apt-get update && apt-get install -y build-essential gcc

# 라이브러리 목록을 복사하고 설치 (production slim set — no PyTorch/Streamlit)
COPY requirements-prod.txt .
RUN pip install --no-cache-dir -r requirements-prod.txt

# 소스코드 전체를 컨테이너 안으로 복사
COPY . .

# app/ 및 프로젝트 루트 모두 import 경로에 포함
# - from app.agent_tools  → /app
# - from agent_tools      → /app/app
# - from config           → /app
ENV PYTHONPATH=/app:/app/app

# 8000번 포트 개방 및 FastAPI 서버 기동
EXPOSE 8000
CMD ["sh", "-c", "PYTHONPATH=/app:/app/app uvicorn app.main:app --host 0.0.0.0 --port 8000"]