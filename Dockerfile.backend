FROM python:3.14-slim-bookworm AS builder

WORKDIR /build
RUN apt-get update \
    && apt-get -y dist-upgrade \
    && apt-get install -y --no-install-recommends build-essential gcc \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-prod.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements-prod.txt

FROM python:3.14-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/app
WORKDIR /app

RUN apt-get update \
    && apt-get -y dist-upgrade \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app
COPY --from=builder /wheels /wheels
COPY requirements-prod.txt .
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements-prod.txt \
    && pip install --no-cache-dir --upgrade \
        "pip>=26.1" \
        "setuptools>=83.0.0" \
        "wheel>=0.46.2" \
        "jaraco.context>=6.1.0" \
    # setuptools still ships older _vendor copies that Trivy flags even after
    # the top-level package is upgraded (CVE-2026-23949 / CVE-2026-24049).
    && find /usr/local/lib/python3.11/site-packages/setuptools/_vendor -maxdepth 1 -type d \
        \( -name 'wheel-0.4[0-5]*.dist-info' \
           -o -name 'wheel-0.46.[01].dist-info' \
           -o -name 'jaraco.context-[0-5].*.dist-info' \
           -o -name 'jaraco.context-6.0*.dist-info' \) \
        -exec rm -rf {} + \
    && rm -rf /wheels

COPY --chown=app:app . .
RUN mkdir -p db_data faiss_index uploaded_evidence data rc_audio_cache \
    && chown -R app:app db_data faiss_index uploaded_evidence data rc_audio_cache

USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
