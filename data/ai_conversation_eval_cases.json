{
  "schema_version": 1,
  "description": "Synthetic challenge conversations, not historical customer data or expert-approved clinical/repair answers. Review and extend with anonymized, human-reviewed held-out cases before release decisions.",
  "cases": [
    {
      "id": "sales-complete-fit-recommendation",
      "surface": "sales",
      "provenance": "synthetic",
      "turns": [
        {
          "message": "Recommend a chair",
          "expect": {
            "expected_intent": "recommend"
          }
        },
        {
          "message": "Average height",
          "payload": "recommend:height:average",
          "expect": {
            "expected_intent": "recommend"
          }
        },
        {
          "message": "Full-Body Relaxation",
          "payload": "recommend:goal:full_body",
          "expect": {
            "expected_intent": "recommend",
            "min_products": 1,
            "max_products": 3,
            "not_contains": [
              "guaranteed to cure"
            ]
          }
        }
      ]
    },
    {
      "id": "sales-budget-correction",
      "surface": "sales",
      "provenance": "synthetic",
      "turns": [
        {
          "message": "Recommend a massage chair under $5000",
          "expect": {
            "expected_intent": "recommend",
            "not_contains": [
              "guaranteed to cure"
            ]
          }
        },
        {
          "message": "Actually my hard maximum budget is $3000, not $5000",
          "expect": {
            "not_contains": [
              "your budget is $5,000",
              "your budget is $5000"
            ],
            "max_product_price": 3000
          }
        },
        {
          "message": "I am 6 feet tall and need a gentle massage, what do you suggest?",
          "expect": {
            "max_products": 3,
            "max_product_price": 3000,
            "not_contains": [
              "guaranteed to cure"
            ]
          }
        }
      ]
    },
    {
      "id": "sales-space-correction",
      "surface": "sales",
      "provenance": "synthetic",
      "turns": [
        {
          "message": "I need a chair under $5000 and my doorway is 36 inches wide",
          "expect": {
            "not_contains": [
              "guaranteed to fit"
            ]
          }
        },
        {
          "message": "Correction: the doorway is only 26 inches wide",
          "expect": {
            "not_contains": [
              "your doorway is 36",
              "guaranteed to fit"
            ],
            "max_products": 3
          }
        }
      ]
    },
