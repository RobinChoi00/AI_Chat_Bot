          "expect": {
            "json_equals": {
              "ticket.model_name": "Solo Flex"
            }
          }
        },
        {
          "action": "state",
          "expect": {
            "json_equals": {
              "ticket.model_name": "Solo Flex"
            },
            "not_contains": [
              "your replacement is approved"
            ]
          }
        }
      ]
    },
