# ==========================================
# 1. Security & Credentials (보안 및 자격 증명) - [무관용 원칙] 절대 업로드 금지
# ==========================================
.env
*.pem
secrets.json

# ==========================================
# 2. Python Environment & Cache (파이썬 캐시 및 가상환경)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
pip-log.txt

# ==========================================
# 3. Vector DB & Large Data (데이터베이스 및 대용량 파일)
# ==========================================
# 원본 CSV 데이터나 생성된 FAISS 인덱스는 Git에 올리지 않습니다.
# (서버 배포 후 데이터 수집 스크립트를 돌려 새로 생성하는 것이 원칙입니다)
data/
faiss_index/
*.jsonl
*.faiss

# raw_data는 인제스터 소스 파일(스펙/상품)만 허용하고 나머지는 무시
raw_data/*
!raw_data/Specification_Massage Chair.xlsx
!raw_data/products_export.csv
!raw_data/Auto-Check.csv
!raw_data/fault_judgment.csv
!raw_data/Warranty Daily Report - Q&A.csv
!raw_data/Sales Policy.docx
!raw_data/Warranty.docx

