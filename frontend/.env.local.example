# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and NEVER committed.

# URL of the FastAPI backend.
# Development (local):   http://localhost:8000
# Docker Compose:        http://backend:8000
# Production (EC2):      https://api.your-domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Admin API key — used server-side ONLY by Next.js Route Handlers.
# NEVER prefix with NEXT_PUBLIC_. Never expose in client components.
# Must match the ADMIN_API_KEY set in the FastAPI backend environment.
ADMIN_API_KEY=your_admin_key_here

# Admin portal login credentials (username + password).
# NEVER prefix with NEXT_PUBLIC_.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# Secret used to sign the admin session cookie (min 32 random characters).
# Generate with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=generate_with_openssl_rand_hex_32
